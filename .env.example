# Discord Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=your_channel_id
APPROVAL_EMOJI=✅
APPROVED_USERS=aymerictotem

# Private channels (optional, for private Discord servers with ideation phase)
# Messages in these channels trigger an ideation phase where Claude asks clarifying questions
# User answers in thread, then adds approval emoji when ready for implementation
# Still requires user to be in APPROVED_USERS list for security
PRIVATE_CHANNEL_IDS=

# GitLab Configuration
GITLAB_URL=http://gitlab.totemmedia.com
GITLAB_TOKEN=your_gitlab_personal_access_token
GITLAB_REPO_URL=http://gitlab.totemmedia.com/Stephane/qtvghd.git
GITLAB_PROJECT_ID=Stephane/qtvghd

# Workspace Configuration
WORKSPACES_DIR=./workspaces

# Claude CLI Configuration
CLAUDE_CLI_PATH=claude

# Storage Configuration
# Options: 'json' (default) or 'supabase'
STORAGE_TYPE=json

# Supabase Configuration (required if STORAGE_TYPE=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: Override machine ID (default: hostname-username)
# MACHINE_ID=my-custom-machine-id
